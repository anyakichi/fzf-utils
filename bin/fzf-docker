#!/bin/bash

set -o pipefail

# shellcheck source=./_fzf-state
. "${0%/*}/_fzf-state"

# shellcheck source=./_fzf-common
. "${0%/*}/_fzf-common"

# The container engine is taken from the command name: fzf-docker runs
# docker, fzf-podman (a symlink to this script) runs podman.
ENGINE=${0##*/}
ENGINE=${ENGINE#fzf-}

containers() {
    local args=()

    case "$1" in
    list)
        if [[ ${S[all]} == true ]]; then
            args+=(-a)
        fi

        "$ENGINE" ps "${args[@]}" "${@:2}"
        ;;
    toggle-all)
        toggle_boolean S[all]
        ;;
    *)
        die "Unknown containers subcommand: $1"
        ;;
    esac
}

fzf-container() {
    containers list |
        fzf --ansi --multi --header-lines=1 \
            --bind "ctrl-r:reload('$0' containers toggle-all && '$0' containers list)" \
            "$@" |
        awk '{print $NF}'
}

fzf-image() {
    "$ENGINE" images |
        fzf --ansi --multi --header-lines=1 \
            --bind "ctrl-r:reload('$ENGINE' images)" \
            "$@" |
        awk '{print ($2 == "<none>") ? $3 : $1":"$2}'
}

# podman only
fzf-pod() {
    "$ENGINE" pod ls |
        fzf --ansi --multi --header-lines=1 \
            --bind "ctrl-r:reload('$ENGINE' pod ls)" \
            "$@" |
        awk '{print $2}'
}

fzf-volume() {
    "$ENGINE" volume ls |
        fzf --ansi --multi --header-lines=1 \
            --bind "ctrl-r:reload('$ENGINE' volume ls)" \
            "$@" |
        awk '{print $2}'
}

CMD="$1"
shift

case "$CMD" in
container)
    fzf-container "$@"
    ;;
containers)
    containers "$@"
    ;;
image)
    fzf-image "$@"
    ;;
pod)
    fzf-pod "$@"
    ;;
volume)
    fzf-volume "$@"
    ;;
*)
    die "Usage: $0 {container|containers|image|pod|volume} [args...]"
    ;;
esac
