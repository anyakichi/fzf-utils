#!/bin/bash

set -o pipefail

# shellcheck source=./_fzf-state
. "${0%/*}/_fzf-state"

# shellcheck source=./_fzf-common
. "${0%/*}/_fzf-common"

CMD="$1"
shift

case "$CMD" in
list)
    if [[ ${S[all]} == true ]]; then
        ps aux
    else
        ps ux
    fi
    ;;
run)
    fzf_args=()
    parse_fzf_args fzf_args "$@"

    "$0" list |
        fzf -m --header-lines=1 \
            --header "$(fzf_header 'C-r: reload' 'C-d: toggle all')" \
            --bind "ctrl-r:reload('$0' list)" \
            --bind "ctrl-d:reload('$0' toggle-all && '$0' list)" \
            "${fzf_args[@]}" |
        awk '{print $2}'
    ;;
toggle-all)
    toggle_boolean S[all]
    ;;
*)
    exit 1
    ;;
esac
