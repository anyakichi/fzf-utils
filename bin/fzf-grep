#!/bin/bash

set -o pipefail

# shellcheck source=./_fzf-state
. "${0%/*}/_fzf-state"

# shellcheck source=./_fzf-common
. "${0%/*}/_fzf-common"

export TVIEW_ENV_VARS="FZF_DEFAULT_OPTS FZF_STATE"

CMD="$1"
shift

case "$CMD" in
list)
    # Usage: list [grep options...] pattern
    HEADER=":: C-d: change directory; C-s: up directory; C-r: cycle restricted"
    header_pre=""

    [[ $# == 0 || -z ${!#} ]] && exit 0

    pattern=${!#}
    args=("${@:1:$#-1}")
    paths=()
    if [[ -n ${S[path]} ]]; then
        paths+=("${S[path]}")
    fi

    if has_command rg; then
        if [[ -n ${S[restricted]} ]]; then
            args+=("${S[restricted]}")
            header_pre+="${S[restricted]} "
        fi

        echo "$header_pre$HEADER"
        # rg searches stdin instead of the directory when stdin is a pipe
        rg --one-file-system --line-number --no-heading --color=always --smart-case \
            "${args[@]}" -e "$pattern" "${paths[@]}" </dev/null
    else
        echo "$header_pre$HEADER"
        grep -rin --color=always "${args[@]}" -e "$pattern" "${paths[@]}"
    fi
    exit 0
    ;;
view)
    setup_pager
    if has_command bat; then
        bat --plain --color=always --paging=always "$1" --highlight-line "$2"
    else
        less "$1"
    fi
    ;;
run)
    fzf_args=()
    cmd_args=()
    parse_fzf_args fzf_args cmd_args "$@"

    "$0" list "${cmd_args[@]}" |
        fzf -m --ansi --disabled \
            --header-lines 1 \
            --delimiter : \
            --bind "change:reload:sleep 0.1; '$0' list {q}" \
            --bind "ctrl-d:reload:fzf-file change-directory && '$0' list {q}" \
            --bind "ctrl-r:reload:'$0' cycle-restricted && '$0' list {q}" \
            --bind "ctrl-s:reload:fzf-file up-directory && '$0' list {q}" \
            --bind "ctrl-t:execute:tview '$0' view {1} {2}" \
            --preview "'$0' view {1} {2}" \
            --preview-window 'hidden,+{2}+3/3' \
            "${fzf_args[@]}" |
        command cut -d ':' -f1
    ;;
cycle-restricted)
    cycle_value S[restricted] "" "-u" "-uu" "-uuu"
    ;;
esac
