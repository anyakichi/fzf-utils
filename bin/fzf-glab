#!/bin/bash

set -o pipefail

# shellcheck source=./_fzf-state
. "${0%/*}/_fzf-state"

# shellcheck source=./_fzf-common
. "${0%/*}/_fzf-common"

# Usage: glab_widget {issue|mr} subcommand [args...]
# Items are listed as "#123 ..." for issues and "!123 ..." for merge requests
glab_widget() {
    local type=$1
    local cmd=$2
    shift 2

    case "$cmd" in
    run)
        local view
        view="'$0' $type view \$(sed -E 's/^[#!]([0-9]+).*$/\\1/' <<< {})"

        S[page]=1

        "$0" "$type" list |
            fzf --ansi --multi --preview-window right:70% \
                --header "$(fzf_header 'C-r: toggle all' 'C-d: next page' 'C-s: prev page')" \
                --bind "ctrl-d:reload:'$0' $type next-page && '$0' $type list" \
                --bind "ctrl-s:reload:'$0' $type prev-page && '$0' $type list" \
                --bind "ctrl-r:reload:'$0' $type toggle-all && '$0' $type list" \
                --bind "ctrl-t:execute:tview $view" \
                --preview "$view | head -n 500" \
                "$@" |
            sed -E 's/^[#!]([0-9]+).*$/\1/'
        ;;
    list)
        local args=()

        if [[ ${S[all]} == true ]]; then
            args+=(-A)
        fi

        if [[ ${S[page]} ]]; then
            args+=(-p "${S[page]}")
        fi

        glab "$type" list -P 100 "${args[@]}" | sed -e 1d -e '/^$/d'
        ;;
    view)
        setup_pager
        glab "$type" view -c -P 100 "$@"
        ;;
    next-page)
        next_page S[page]
        ;;
    prev-page)
        prev_page S[page]
        ;;
    toggle-all)
        toggle_boolean S[all]
        ;;
    *)
        die "Unknown $type subcommand: $cmd"
        ;;
    esac
}

case "$1" in
issue | mr)
    glab_widget "$@"
    ;;
*)
    die "Usage: $0 {issue|mr} [subcommand] [args...]"
    ;;
esac
