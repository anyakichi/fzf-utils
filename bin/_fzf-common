#!/bin/bash
# Common utilities for fzf-utils commands

# Error handling utilities
# Usage: die "error message" [exit_code]
die() {
    local message=$1
    local exit_code=${2:-1}
    echo "Error: $message" >&2
    exit "$exit_code"
}

# Split the command line into fzf arguments and command arguments at "--"
# Usage: parse_fzf_args fzf_args cmd_args "$@"
# Arguments before "--" go to fzf_args, arguments after it to cmd_args.
parse_fzf_args() {
    local -n _fzf_args=$1 _cmd_args=$2
    shift 2
    _fzf_args=()
    _cmd_args=()
    while (($# > 0)); do
        if [[ $1 == "--" ]]; then
            shift
            _cmd_args=("$@")
            return
        fi
        _fzf_args+=("$1")
        shift
    done
}

# Toggle boolean state value
# Usage: toggle_boolean S[all]
toggle_boolean() {
    # shellcheck disable=SC2178,SC2128
    local -n var=$1
    if [[ $var == true ]]; then
        var="false"
    else
        var="true"
    fi
}

# Setup pager environment
setup_pager() {
    export PAGER=less
    export LESS=-KMRc
}

# View file with bat or less fallback
# Usage: view_file filename
view_file() {
    local file=$1
    if has_command bat; then
        bat --plain --color=always --paging=always "$file"
    else
        less "$file"
    fi
}

# Increment page number
# Usage: next_page S[page]
next_page() {
    # shellcheck disable=SC2178,SC2128
    local -n _page_ref=$1
    _page_ref=$((_page_ref + 1))
}

# Decrement page number (min 1)
# Usage: prev_page S[page]
prev_page() {
    # shellcheck disable=SC2178,SC2128
    local -n _page_ref=$1
    if ((_page_ref > 1)); then
        _page_ref=$((_page_ref - 1))
    fi
}

# Cycle through values
# Usage: cycle_value S[mode] "value1" "value2" "value3"
cycle_value() {
    # shellcheck disable=SC2178,SC2128
    local -n var=$1
    shift
    local values=("$@")
    local current_index=-1 i

    # Find current value index
    for i in "${!values[@]}"; do
        if [[ ${values[$i]} == "$var" ]]; then
            current_index=$i
            break
        fi
    done

    # Set to next value (or first if not found/at end)
    if ((current_index == -1 || current_index == ${#values[@]} - 1)); then
        var="${values[0]}"
    else
        var="${values[$((current_index + 1))]}"
    fi
}

# Common fzf header with keybinding hints
# Usage: fzf_header "C-r: reload" "C-d: next" "C-s: prev"
fzf_header() {
    echo ":: $*"
}

# Check if command exists
# Usage: has_command command_name
has_command() {
    command -v "$1" &>/dev/null
}

# Get file viewer command
# Returns appropriate viewer (bat, cat, less) based on availability
get_file_viewer() {
    if has_command bat; then
        echo "bat --plain --color=always"
    else
        echo "cat"
    fi
}

# Get directory lister command
# Returns appropriate lister (eza, exa, ls) based on availability
get_dir_lister() {
    if has_command eza; then
        echo "eza -laF --color=always"
    elif has_command exa; then
        echo "exa -laF --color=always"
    else
        echo "ls -la"
    fi
}
